# Healthcare Realtime Vitals Lakehouse — Environment
# Copy to .env and adjust. NO REAL SECRETS — everything is dummy/local (Floci).

# --- AWS / Floci ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Hostname other containers use to reach Floci inside the compose network.
FLOCI_HOSTNAME=floci
# memory (CI) | hybrid (dev default, ~5s flush) | persistent | wal
FLOCI_STORAGE_MODE=hybrid

# --- Iceberg catalog ---
# nessie = TRINO_ICEBERG_CATALOG primary (proven path; default).
# glue   = Floci Glue Data Catalog (SPIKE -- Floci lacks Glue UpdateTable,
#          Iceberg commits via Trino may not persist; M1 milestone).
ICEBERG_CATALOG=nessie

# --- Trino ---
TRINO_HOST=127.0.0.1
TRINO_PORT=8082
TRINO_USER=trino
TRINO_ICEBERG_CATALOG=iceberg

# --- Superset ---
SUPERSET_URL=http://127.0.0.1:8088
SUPERSET_SECRET_KEY=healthcare_2026_secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@superset.local

# --- Superset metadata DB ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=healthcare

# --- Kinesis ---
VITALS_STREAM_NAME=vitals
STREAM_SHARD_COUNT=1
FIREHOSE_DELIVERY_STREAM=vitals-raw
FIREHOSE_BUFFER_INTERVAL_SECONDS=30

# --- DynamoDB ---
ALERTS_TABLE=alerts
LATEST_VITALS_TABLE=latest_vitals

# --- SNS ---
ALERT_TOPIC_NAME=vitals-alerts

# --- Lambda / runtime ---
LAMBDA_RUNTIME=python3.12
LAMBDA_ALERT_NOTIFIER_ENV=dev

# --- Synthea ---
SYNTHEA_VERSION=latest
SYNTHEA_PATIENTS=5000
SYNTHEA_SEED=1